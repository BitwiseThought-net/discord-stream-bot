# =============================================================================
# discord-stream-bot - .env.example
# =============================================================================
#
# Every variable below is confirmed directly against bot.py's own
# os.getenv(...) calls (verified against the actual repo source, not
# inferred). Every variable has a default that lets the bot run with zero
# changes to this file, EXCEPT the ones marked (REQUIRED).

# -----------------------------------------------------------------------
# CORE BOT CONFIGURATION
# -----------------------------------------------------------------------

# Discord bot token from the Discord Developer Portal. (REQUIRED)
DISCORD_TOKEN=

# Base name used for the bot's slash command group -- commands appear as
# /<COMMAND_BASE> ... (e.g. /radio start).
COMMAND_BASE=radio

# Controls startup behavior when a previous session's state is found.
# 'resume' (default) picks back up where it left off; 'stay_disconnected'
# skips reconnecting/restoring on boot.
RECOVERY_MODE=resume

# -----------------------------------------------------------------------
# STORAGE PATHS
# -----------------------------------------------------------------------

# Base directory for all persisted bot state (state file, sources cache,
# FIFO pipe default location).
DATA_DIR=/data

# Where session state (tuned frequency, volume, selected source/device) is
# saved so it survives a restart.
STATE_FILE=/data/state.json

# Cache of discovered/available hardware sources.
SOURCES_CACHE_FILE=/data/sources_cache.json

# Path to the named pipe (FIFO) that every audio source -- hardware, SDR,
# and the Android emulator bridge -- writes into before it's sent to
# Discord voice.
FIFO_PIPE=/data/audio_pipe

# Directory holding the per-source JSON profiles (sources/*.json).
SOURCES_DIR=/sources

# -----------------------------------------------------------------------
# ANDROID EMULATOR SOURCE (sources/android_emulator.json, pipeline_type:
# docker_compose) -- see docs/sources.md
# -----------------------------------------------------------------------
# All of the following are optional. Defaults are chosen so the source
# works with zero configuration on both ARM (e.g. Raspberry Pi) and
# x86_64 hosts -- set any of these only if you need to override a default.

# Image used for the Android emulator container. Must be a genuine
# multi-arch manifest if you change it -- see docs/sources.md for why the
# same tag is used regardless of host architecture.
ANDROID_EMULATOR_IMAGE=shmayro/dockerify-android:latest

# Name of the Docker named volume shared between the Android container
# and the bot's audio bridge. Change this if running multiple bot
# instances on the same host to avoid volume name collisions.
ANDROID_DATA_VOLUME=android_output

# How long (in seconds) to wait for `docker compose up --wait` to report
# the container healthy before giving up and proceeding anyway. Leave
# unset to use the automatic default: 30s on hosts with KVM available,
# 90s without (most ARM boards fall in the latter case). Only set this to
# force a specific value regardless of host capability.
#ANDROID_STARTUP_TIMEOUT_S=

# Directory the bot writes the temporary docker-compose file to before
# starting the Android stack. Override on hosts that restrict writes/exec
# in /tmp.
COMPOSE_TMP_DIR=/tmp

# Enables the Android emulator's built-in web UI (KasmVNC-based). Set to
# false to disable the web UI entirely for this source.
ANDROID_WEB_VNC=true

# Port the web UI listens on when ANDROID_WEB_VNC=true.
ANDROID_WEB_PORT=3000

# The address (LAN IP or domain) the bot should tell users to connect to
# for the web UI, returned by the `/radio android-ui` command. The bot has
# no reliable way to determine this on its own -- set it if you use the
# web UI, otherwise that command returns a placeholder instead of a
# working link. (REQUIRED if you plan to use the web UI)
ANDROID_WEB_HOST=
