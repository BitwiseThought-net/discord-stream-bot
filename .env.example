# =========================================================================
# Copy this file to .env and fill in the values you need. Anything left
# unset falls back to the default shown in the comment above it.
# =========================================================================

# ---- Required -----------------------------------------------------------

# Your bot's token from the Discord Developer Portal. The bot will not
# start without this.
DISCORD_TOKEN=your_actual_discord_bot_token_here

# ---- Core behavior --------------------------------------------------------

# Root name of the slash command group, e.g. "radio" gives you /radio start,
# /radio input, etc. Change this to run multiple instances of the bot in
# the same server without command-name collisions.
# Default: radio
COMMAND_BASE=radio

# What happens on boot if the bot was actively streaming when it last shut
# down (crash, reboot, power loss, etc). "resume" reconnects to the last
# voice channel and restarts the last-used source automatically; any other
# value leaves the bot idle until you run a command manually.
# Default: resume
RECOVERY_MODE=resume

# ---- Storage paths --------------------------------------------------------
# These generally don't need to change inside the provided Docker setup --
# docker-compose.yml already mounts a persistent volume at /data and a
# read-only bind mount of ./sources at /sources. Override only if you're
# running outside that container layout.

# Base directory for all persisted bot state (state.json, sources_cache.json,
# the audio FIFO pipe, and the package allowlist file below all live here
# unless individually overridden).
# Default: /data
DATA_DIR=/data

# Where the bot persists which voice channel/source it was last streaming,
# used by RECOVERY_MODE=resume.
# Default: <DATA_DIR>/state.json
STATE_FILE=

# Cache of the last hardware source scan (populated by /radio input).
# Default: <DATA_DIR>/sources_cache.json
SOURCES_CACHE_FILE=

# Named pipe used as the continuous shared audio buffer between the capture
# process and the Discord voice stream.
# Default: <DATA_DIR>/audio_pipe
FIFO_PIPE=

# Directory scanned for pluggable source .py files (alsa.py, sdr_radio.py,
# etc). Each file is a self-contained plugin -- see the SOURCE PLUGIN
# CONTRACT comment near the top of bot.py.
# Default: /sources
SOURCES_DIR=/sources

# ---- Dependency whitelisting & auto-install --------------------------------
# See the "DEPENDENCY WHITELISTING & AUTO-INSTALL" section in bot.py for
# full details on how this system works.

# Where the live, editable package allowlist is stored once seeded.
# Default: <DATA_DIR>/package_allowlist.json
PACKAGE_ALLOWLIST_FILE=

# Checked-in starter list used to seed PACKAGE_ALLOWLIST_FILE the first time
# the bot boots against a fresh /data volume. Edit package_allowlist.example.json
# (at the repo root) before first boot to pre-approve extra packages, or
# point this at a different file entirely.
# Default: <repo root>/package_allowlist.example.json
PACKAGE_ALLOWLIST_TEMPLATE=

# Optional webhook URL (e.g. a private Discord channel webhook) that gets
# notified when a loaded source declares a package dependency that ISN'T on
# the allowlist yet. Leave unset to disable webhook reporting -- missing
# dependencies are still always logged to the console either way.
# Default: (unset -- webhook reporting disabled)
DEPENDENCY_WEBHOOK_URL=

# Commands used to update package lists, install, and check whether a
# package is already installed. Only change these if you're running on a
# non-Debian/Ubuntu-based host (the defaults assume apt/dpkg).
# Defaults shown below:
PACKAGE_MANAGER_UPDATE_CMD=apt-get update
PACKAGE_MANAGER_INSTALL_CMD=apt-get install -y
PACKAGE_MANAGER_CHECK_CMD=dpkg -s
