# =============================================================================
# discord-stream-bot — .env.example
# =============================================================================
#
# NOTE ON THIS FILE: this was assembled from what's visible in the bot.py
# diff for PR #52 (which references COMMAND_NAME and $FIFO_PIPE, among
# others) plus the new Android-emulator-source variables added in this
# pass. The core bot variables below (Discord token, IDs, etc.) are
# standard for this kind of bot but were NOT individually confirmed
# against the live .env.example, since that file wasn't directly
# reachable during this analysis. Merge this against the real file rather
# than replacing it outright — keep whatever's already there under
# "EXISTING BOT CONFIGURATION" and reconcile names/defaults, and add the
# "ANDROID EMULATOR SOURCE" section as new.
#
# Every variable below has a default that lets the bot run with zero
# changes to this file, EXCEPT the ones marked (REQUIRED) — those have no
# safe default and must be set.

# -----------------------------------------------------------------------
# EXISTING BOT CONFIGURATION — verify against the live .env.example
# -----------------------------------------------------------------------

# Discord bot token from the Discord Developer Portal. (REQUIRED)
DISCORD_TOKEN=

# Guild (server) ID the bot's slash commands are scoped to, if the bot
# registers commands per-guild rather than globally. (REQUIRED if used)
DISCORD_GUILD_ID=

# Default voice channel ID to stream into, if the bot doesn't always
# prompt the user to pick one. (REQUIRED if used)
DISCORD_VOICE_CHANNEL_ID=

# Base name used for the bot's slash command group (referenced as
# COMMAND_NAME in bot.py — e.g. commands appear as /radio ...).
COMMAND_NAME=radio

# Path to the named pipe (FIFO) that all audio sources — hardware, SDR,
# and now the Android emulator bridge — write into before it's sent to
# Discord voice.
FIFO_PIPE=/tmp/audio_fifo

# -----------------------------------------------------------------------
# ANDROID EMULATOR SOURCE — new in this pass (see docs/sources.md)
# -----------------------------------------------------------------------
# All of the following are optional. Defaults are chosen so the source
# works with zero configuration on both ARM (e.g. Raspberry Pi) and
# x86_64 hosts — set any of these only if you need to override a default.

# Image used for the Android emulator container. Must be a genuine
# multi-arch manifest if you change it — see docs/sources.md §1a for why
# the same tag is used regardless of host architecture.
ANDROID_EMULATOR_IMAGE=linuxserver/android:armv7-x86_64

# Name of the Docker named volume shared between the Android container
# and the bot's audio bridge. Change this if running multiple bot
# instances on the same host to avoid volume name collisions.
ANDROID_DATA_VOLUME=android_output

# How long (in seconds) to wait for the emulator container to report
# healthy before giving up and proceeding anyway. Leave unset to use the
# automatic default: 30s on hosts with KVM available, 90s without (ARM
# boards typically fall in the latter case). Only set this to force a
# specific value regardless of host capability.
#ANDROID_STARTUP_TIMEOUT_S=

# Directory the bot writes the temporary docker-compose file to before
# starting the Android stack. Override on hosts that restrict writes/exec
# in /tmp.
COMPOSE_TMP_DIR=/tmp

# Enables the Android emulator's built-in web UI (KasmVNC-based). Set to
# false to disable the web UI entirely for this source.
ANDROID_WEB_VNC=true

# Port the web UI listens on when ANDROID_WEB_VNC=true.
ANDROID_WEB_PORT=3000

# The address (LAN IP or domain) the bot should tell users to connect to
# for the web UI, returned by the `android-ui` command. The bot has no
# reliable way to determine this on its own — set it if you enable the
# web UI, otherwise the android-ui command will return a placeholder
# instead of a working link. (REQUIRED if ANDROID_WEB_VNC=true)
ANDROID_WEB_HOST=
