DISCORD_TOKEN=your_actual_discord_bot_token_here
COMMAND_BASE=radio
RECOVERY_MODE=resume

# Optional: a webhook URL (e.g. a private Discord channel webhook) that gets
# notified when a loaded source declares a package dependency that ISN'T on
# the package allowlist yet. Leave blank/unset to disable webhook reporting
# (missing dependencies are still always logged to the console either way).
DEPENDENCY_WEBHOOK_URL=
