name: PR Verification Test Suite

on:
  pull_request:
    types: [opened, synchronize, reopened]

permissions:
  id-token: write
  contents: read
  checks: write
  pull-requests: write

jobs:
  linting-optional:
    runs-on: ubuntu-latest
    continue-on-error: true # <-- Makes linting optional (PR will not block on style errors)
    steps:
      - name: Checkout Code Repository
        uses: actions/checkout@v5

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Run Optional Linter Check
        run: |
          pip install flake8 || true
          flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics || true

  run-tests:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code Repository
        uses: actions/checkout@v5

      - name: Setup Python Environment
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install System Architecture Packages
        run: |
          sudo apt-get update
          sudo apt-get install -y alsa-utils libasound2-dev

      - name: Install Test Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest pytest-cov discord.py PyNaCl

      - name: Execute Comprehensive Test Suite
        run: |
          echo "🚀 Running test suite with strict coverage tracking..."
          pytest --cov=stream_bot --cov-report=xml test_bot.py -v

      # Enforces a mandatory, breaking 70% threshold boundary block
      - name: Publish Code Coverage Summary
        uses: 5monkeys/cobertura-action@master
        if: success() || failure()
        with:
          path: coverage.xml
          repo_token: ${{ secrets.GITHUB_TOKEN }}
          minimum_coverage: 70
          fail_below_min: true # <-- FORCES PR FAILURE IF UNDER THE 70% MINIMUM BOUNDARY
